      "fontSize": 17,
      "fontFamily": 5,
      "text": "Concurrent requests with the same key: UNIQUE constraint makes one transaction win; the other waits, then\nreads and replays the winner’s result. If the winner rolls back, the other can proceed.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Concurrent requests with the same key: UNIQUE constraint makes one transaction win; the other waits, then reads and replays the winner’s result. If the winner rolls back, the other can proceed.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
