      "updated": 1791883333849,
      "created": 1791820388520,
      "link": null,
      "locked": false,
      "text": "Worker atomically claims a QUEUED initialization or reclaims one with an expired SUBMITTING lease; sets SUBMITTING and lease expiry, then calls Paystack using its stored reference. On recovery, reconcile by reference before retrying initialization.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zLDLo4ZfsLZN6ScrrF7aQ",
      "originalText": "Worker atomically claims a QUEUED initialization or reclaims one with an expired SUBMITTING lease; sets SUBMITTING and lease expiry, then calls Paystack using its stored reference. On recovery, reconcile by reference before retrying initialization.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
