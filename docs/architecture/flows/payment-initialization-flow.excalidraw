    {
      "id": "Dba5HWWIttLIoAze0XQim",
      "type": "text",
      "x": 7245.8082929062375,
      "y": 3238.3484791093174,
      "width": 570.8666381835938,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06G",
      "roundness": null,
      "seed": 1731854590,
      "version": 1082,
      "versionNonce": 614723188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791883425020,
      "created": 1791811678090,
      "link": null,
      "locked": false,
      "text": "On definitive rejection, set status REJECTED and save the reason. While the booking hold is valid, allow a new initialization with a new idempotency key and fresh Paystack reference under the same payment attempt. Only retry after Paystack confirms no checkout was created. Because Paystack confirmed no checkout was created, if the hold expires before a new initialization, cancel the booking and release its seat claims. For an ambiguous payment that may have reached Paystack, use PAYMENT_REVIEW and preserve claims instead. This does not mark payment FAILED.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lKjb_ZJuA2_84q6WAGMgg",
      "originalText": "On definitive rejection, set status REJECTED and save the reason. While the booking hold is valid, allow a new initialization with a new idempotency key and fresh Paystack reference under the same payment attempt. Only retry after Paystack confirms no checkout was created. Because Paystack confirmed no checkout was created, if the hold expires before a new initialization, cancel the booking and release its seat claims. For an ambiguous payment that may have reached Paystack, use PAYMENT_REVIEW and preserve claims instead. This does not mark payment FAILED.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
