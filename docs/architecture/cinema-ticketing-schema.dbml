// Cinema ticketing backend: first-pass logical schema.
// DBML documentation: https://dbml.dbdiagram.io/docs

enum BookingStatus {
  RESERVED
  PAYMENT_REVIEW
  BOOKED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD
  MPESA
}

enum PaymentInitializationStatus {
  QUEUED [note: 'Committed and waiting for a worker to contact Paystack']
  SUBMITTING [note: 'A worker has claimed this initialization and is contacting Paystack']
  READY [note: 'Paystack created checkout; authorization_url is stored']
  FAILED [note: 'Paystack verification confirmed the payment attempt failed']
  REJECTED [note: 'Paystack definitively confirmed that no checkout was created']
  UNKNOWN [note: 'Paystack outcome is uncertain; reconcile by reference before another initialization']
  CANCELLED [note: 'Payment attempt was explicitly cancelled; Paystack abandoned remains pending while the booking hold is valid']
  REVIEW_REQUIRED [note: 'Payment state conflicts with provider verification; excluded from worker claims pending review']
}

enum StaffRole {
  MANAGER [note: 'Can manage staff accounts and redeem tickets']
  SCANNER [note: 'Can redeem tickets only']
}

enum StaffAccountStatus {
  INVITED [note: 'Password setup has not been completed']
  ACTIVE
  DISABLED
}

enum EmailOutboxKind {
  BOOKING_TICKETS
  STAFF_INVITATION
}

enum EmailOutboxStatus {
  QUEUED
  SENDING
  SENT
  FAILED [note: 'Terminal after permanent failure or retry exhaustion; can be reviewed and re-queued']
}

Table auditoriums {
  id integer [primary key]
  name varchar [not null]
  created_at timestamp [not null]
}

Table movies {
  id integer [primary key]
  name varchar [not null]
  description varchar [not null]
  runtime_minutes integer [not null]
  created_at timestamp [not null]

  checks {
    `runtime_minutes > 0` [name: 'movies_runtime_positive']
  }
}

Table screenings {
  id integer [primary key]
  movie_id integer [ref: > movies.id, not null]
  auditorium_id integer [ref: > auditoriums.id, not null]
  currency varchar(3) [not null, note: 'All seat prices for this screening use this currency']
  start_time datetime [not null]
  end_time datetime [not null]
  created_at timestamp [not null]

  indexes {
    (id, auditorium_id) [unique]
    (id, currency) [unique]
  }

  checks {
    `end_time > start_time` [name: 'screenings_end_after_start']
  }
}

Table seats {
  id integer [primary key]
  label varchar [not null]
  auditorium_id integer [ref: > auditoriums.id, not null]
  created_at timestamp [not null]

  indexes {
    (id, auditorium_id) [unique]
    (auditorium_id, label) [unique]
  }
}

// One row for each seat offered in a screening, with that screening's price.
Table screening_seats {
  screening_id integer [not null]
  seat_id integer [not null]
  auditorium_id integer [not null]
  price_amount integer [not null, note: 'Stored in minor currency units']

  indexes {
    (screening_id, seat_id) [pk]
  }

  checks {
    `price_amount > 0` [name: 'screening_seats_price_positive']
  }
}

Table bookings {
  id integer [primary key]
  booking_reference varchar [unique, not null]
  idempotency_key varchar [not null, unique]
  request_fingerprint varchar [not null, note: 'Compared on idempotency replay; not unique']
  customer_email varchar [not null]
  customer_phone varchar [not null]
  status BookingStatus [not null]
  screening_id integer [ref: > screenings.id, not null]
  hold_expires_at datetime [not null]
  created_at timestamp [not null]

  indexes {
    (id, screening_id) [unique]
  }

  checks {
    `hold_expires_at > created_at` [name: 'bookings_hold_expires_after_creation']
  }
}

Table payment_attempts {
  id integer [primary key]
  booking_id integer [ref: - bookings.id, not null, unique]
  status PaymentStatus [not null]
  amount integer [not null, note: 'Stored in minor currency units']
  currency varchar(3) [not null, note: 'Three-letter currency code, e.g. KES']
  created_at timestamp [not null]

  checks {
    `amount > 0` [name: 'payment_attempts_amount_positive']
  }
}

// Each initialization gets its own provider reference.
// A definitively rejected initialization can be retained as history while a
// new initialization is created under the same payment attempt.
Table payment_initializations {
  id integer [primary key]
  payment_attempt_id integer [ref: > payment_attempts.id, not null]
  paystack_reference varchar [unique, not null, note: 'Generated and persisted before calling Paystack']
  payment_method PaymentMethod [not null]
  authorization_url varchar [note: 'Nullable until Paystack returns hosted checkout details']
  status PaymentInitializationStatus [not null]
  rejection_reason varchar
  worker_attempt_count integer [not null, default: 0, note: 'Incremented whenever a worker claims this job']
  next_attempt_at timestamp
  lease_expires_at timestamp [note: 'Allows recovery if a worker crashes while SUBMITTING']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    payment_attempt_id
  }
}

// Every accepted request has its own receipt, even when it returns an existing
// unresolved initialization. The requested method can differ from that initialization's method.
Table payment_initialization_receipts {
  idempotency_key varchar [primary key]
  request_fingerprint varchar [not null]
  requested_payment_method PaymentMethod [not null]
  payment_initialization_id integer [ref: > payment_initializations.id, not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]
}

// Database-specific partial unique index required in the migration:
// at most one initialization per payment_attempt_id in QUEUED, SUBMITTING,
// READY, UNKNOWN, or REVIEW_REQUIRED. REVIEW_REQUIRED remains unresolved but
// is excluded from worker claims until reviewed. FAILED, REJECTED, and
// CANCELLED rows remain as terminal history.
// DBML cannot express this predicate; do not replace it with a plain unique
// index, which would forbid retries after a definitive rejection.

// Durable history of the seats selected for each booking. Keep these rows
// when a booking is cancelled so support can see what the customer selected.
Table bookings_seats {
  booking_id integer [not null]
  seat_id integer [not null]
  screening_id integer [not null]
  unit_price_amount integer [not null, note: 'Price snapshot in minor currency units']
  currency varchar(3) [not null, note: 'Currency snapshot for this booking seat']

  indexes {
    (booking_id, seat_id) [pk]
  }

  checks {
    `unit_price_amount > 0` [name: 'bookings_seats_price_positive']
  }
}

// Current occupancy only. Keep claims for RESERVED, PAYMENT_REVIEW, and
// BOOKED bookings; remove claims when a confirmed failure/cancellation
// releases seats. The historical booking_seats rows remain.
Table seat_claims {
  screening_id integer [not null]
  seat_id integer [not null]
  booking_id integer [not null]

  indexes {
    (screening_id, seat_id) [pk]
  }
}

// Exactly one ticket per historical booking-seat row. The raw QR credential
// is generated by the application, stored as an AEAD ciphertext for later
// rendering, and indexed by its SHA-256 digest during scans. Do not put PII or
// booking/seat data in the QR payload.
Table tickets {
  id integer [primary key]
  booking_id integer [not null]
  seat_id integer [not null]
  credential_digest bytea [not null, unique, note: '32-byte SHA-256 digest of the random QR bearer credential']
  credential_ciphertext bytea [not null, note: 'Authenticated-encryption ciphertext; key is configured outside PostgreSQL']
  credential_key_version smallint [not null]
  redeemed_at timestamptz
  redeemed_by_staff_account_id integer
  created_at timestamptz [not null]

  indexes {
    (booking_id, seat_id) [unique]
    (redeemed_by_staff_account_id, redeemed_at)
  }

  checks {
    `octet_length(credential_digest) = 32` [name: 'tickets_credential_digest_length']
    `credential_key_version > 0` [name: 'tickets_credential_key_version_positive']
    `(redeemed_at IS NULL) = (redeemed_by_staff_account_id IS NULL)` [name: 'tickets_redemption_audit_pair']
  }
}

// Accounts are created by the initial owner/manager or a manager. There is no
// public self-registration. Normalize email addresses before persistence.
Table staff_accounts {
  id integer [primary key]
  email varchar [not null, unique, note: 'Stored lowercase; application normalizes before insert']
  display_name varchar [not null]
  role StaffRole [not null]
  status StaffAccountStatus [not null]
  password_hash varchar [note: 'Adaptive password hash; null until invitation setup completes']
  mfa_secret_ciphertext bytea [note: 'Encrypted TOTP secret; null until enrollment begins']
  mfa_key_version smallint
  mfa_enabled_at timestamptz
  is_bootstrap_owner boolean [not null, default: false]
  created_by_staff_account_id integer
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `email <> '' AND email = lower(btrim(email))` [name: 'staff_accounts_email_normalized']
    `display_name <> '' AND display_name = btrim(display_name)` [name: 'staff_accounts_display_name_not_empty']
    `status <> 'INVITED' OR password_hash IS NULL` [name: 'staff_invited_account_has_no_password']
    `status <> 'ACTIVE' OR password_hash IS NOT NULL` [name: 'staff_active_account_requires_password']
    `status <> 'ACTIVE' OR mfa_enabled_at IS NOT NULL` [name: 'staff_active_account_requires_mfa']
    `NOT is_bootstrap_owner OR role = 'MANAGER'` [name: 'staff_bootstrap_owner_is_manager']
    `(mfa_secret_ciphertext IS NULL) = (mfa_key_version IS NULL)` [name: 'staff_accounts_mfa_ciphertext_key_version_pair']
    `mfa_key_version IS NULL OR mfa_key_version > 0` [name: 'staff_accounts_mfa_key_version_positive']
    `mfa_enabled_at IS NULL OR mfa_secret_ciphertext IS NOT NULL` [name: 'staff_accounts_mfa_enabled_has_secret']
  }
}

// Recovery codes are random, single-use credentials. Store only their SHA-256
// digests and consume each code atomically.
Table staff_recovery_codes {
  id integer [primary key]
  staff_account_id integer [not null]
  code_digest bytea [not null, unique, note: '32-byte SHA-256 digest of one recovery code']
  created_at timestamptz [not null]
  consumed_at timestamptz

  indexes {
    staff_account_id
  }

  checks {
    `octet_length(code_digest) = 32` [name: 'staff_recovery_codes_digest_length']
  }
}

// Password verification creates a short-lived challenge, never a session.
Table staff_auth_challenges {
  id integer [primary key]
  staff_account_id integer [not null]
  token_digest bytea [not null, unique, note: '32-byte SHA-256 digest of opaque challenge token']
  purpose varchar [not null, note: 'MFA_SIGN_IN or MFA_ENROLLMENT']
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  failed_attempts smallint [not null, default: 0]
  consumed_at timestamptz

  indexes {
    (staff_account_id, expires_at)
  }

  checks {
    `octet_length(token_digest) = 32` [name: 'staff_auth_challenges_digest_length']
    `purpose IN ('MFA_SIGN_IN', 'MFA_ENROLLMENT')` [name: 'staff_auth_challenges_purpose_valid']
    `expires_at > created_at` [name: 'staff_auth_challenges_expiry_after_creation']
    `failed_attempts BETWEEN 0 AND 5` [name: 'staff_auth_challenges_attempts_bounded']
  }
}

// Each invitation is single-use. Retain a digest for validation and an
// encrypted copy only while needed to retry the invitation email; clear the
// ciphertext after successful delivery or when the invitation is consumed.
Table staff_invitations {
  id integer [primary key]
  staff_account_id integer [not null]
  token_digest bytea [not null, unique, note: '32-byte SHA-256 digest of the single-use setup token']
  token_ciphertext bytea [note: 'Authenticated-encryption ciphertext used by the durable email job; cleared when no longer needed']
  token_key_version smallint
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  created_by_staff_account_id integer [not null]
  created_at timestamptz [not null]

  indexes {
    staff_account_id
  }

  checks {
    `octet_length(token_digest) = 32` [name: 'staff_invitations_token_digest_length']
    `(token_ciphertext IS NULL) = (token_key_version IS NULL)` [name: 'staff_invitation_ciphertext_key_version_pair']
    `token_key_version IS NULL OR token_key_version > 0` [name: 'staff_invitations_key_version_positive']
    `expires_at > created_at` [name: 'staff_invitations_expiry_after_creation']
    `NOT (consumed_at IS NOT NULL AND revoked_at IS NOT NULL)` [name: 'staff_invitations_not_consumed_and_revoked']
  }
}

// Store only a digest of the opaque session token. Expiration and idle timeout
// are enforced by the application; revoked_at supports logout/deactivation.
Table staff_sessions {
  id integer [primary key]
  staff_account_id integer [not null]
  token_digest bytea [not null, unique, note: '32-byte SHA-256 digest of the opaque session token']
  created_at timestamptz [not null]
  last_activity_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Absolute maximum lifetime: 8 hours']
  revoked_at timestamptz

  indexes {
    (staff_account_id, expires_at)
  }

  checks {
    `octet_length(token_digest) = 32` [name: 'staff_sessions_token_digest_length']
    `expires_at > created_at` [name: 'staff_sessions_expiry_after_creation']
    `last_activity_at >= created_at` [name: 'staff_sessions_last_activity_after_creation']
  }
}

// A durable, database-backed queue for booking ticket and staff invitation
// emails. Sensitive tokens are read from their encrypted source records, not
// copied into this queue. Delivery is at-least-once: a provider timeout after
// acceptance can result in a duplicate email, but never duplicate tickets.
Table email_outbox {
  id integer [primary key]
  event_key varchar [not null, unique, note: 'Idempotency key for creating this email job']
  kind EmailOutboxKind [not null]
  recipient_email varchar [not null]
  booking_id integer
  staff_invitation_id integer
  status EmailOutboxStatus [not null]
  attempt_count integer [not null, default: 0]
  next_attempt_at timestamptz [not null]
  lease_expires_at timestamptz
  last_error_code varchar [note: 'Sanitized error category only; do not store provider response bodies or secrets']
  sent_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (next_attempt_at, id)
    booking_id
  }

  checks {
    `attempt_count >= 0` [name: 'email_outbox_attempt_count_nonnegative']
    `(status = 'SENDING') = (lease_expires_at IS NOT NULL)` [name: 'email_outbox_sending_requires_lease']
    `(status = 'SENT') = (sent_at IS NOT NULL)` [name: 'email_outbox_sent_requires_timestamp']
    `(kind = 'BOOKING_TICKETS' AND booking_id IS NOT NULL AND staff_invitation_id IS NULL) OR (kind = 'STAFF_INVITATION' AND booking_id IS NULL AND staff_invitation_id IS NOT NULL)` [name: 'email_outbox_kind_requires_matching_reference']
  }
}

// A screening seat must belong to the screening's auditorium and be a seat
// in that auditorium. This row is the source of the offered seat price.
Ref: screening_seats.(screening_id, auditorium_id) > screenings.(id, auditorium_id)
Ref: screening_seats.(seat_id, auditorium_id) > seats.(id, auditorium_id)

// Ensure the historical booking-seat row matches the booking and the offered
// seat for that screening. Its unit price is a snapshot taken at booking time.
Ref: bookings_seats.(booking_id, screening_id) > bookings.(id, screening_id)
Ref: bookings_seats.(screening_id, seat_id) > screening_seats.(screening_id, seat_id)
Ref: bookings_seats.(screening_id, currency) > screenings.(id, currency)

// Ensure each active claim matches that historical booking-seat row and
// still belongs to the correct booking and screening.
Ref: seat_claims.(booking_id, seat_id) > bookings_seats.(booking_id, seat_id)
Ref: seat_claims.(booking_id, screening_id) > bookings.(id, screening_id)
Ref: seat_claims.(screening_id, seat_id) > screening_seats.(screening_id, seat_id)

// Ticket issuance is tied to the immutable booking-seat snapshot; one row per
// seat is enforced by the unique key on tickets.(booking_id, seat_id).
Ref: tickets.(booking_id, seat_id) > bookings_seats.(booking_id, seat_id)
Ref: tickets.redeemed_by_staff_account_id > staff_accounts.id

Ref: staff_accounts.created_by_staff_account_id > staff_accounts.id
Ref: staff_invitations.staff_account_id > staff_accounts.id
Ref: staff_invitations.created_by_staff_account_id > staff_accounts.id
Ref: staff_sessions.staff_account_id > staff_accounts.id
Ref: staff_recovery_codes.staff_account_id > staff_accounts.id
Ref: staff_auth_challenges.staff_account_id > staff_accounts.id
Ref: email_outbox.booking_id > bookings.id
Ref: email_outbox.staff_invitation_id > staff_invitations.id

// PostgreSQL migration must add partial unique indexes that DBML cannot
// faithfully express: at most one bootstrap owner; at most one active
// (unconsumed/unrevoked) invitation per account; and at most one
// BOOKING_TICKETS email job per booking and at most one active invitation per
// account; expired invitations must be revoked before replacing them. Add a
// partial due-work index for QUEUED jobs and an expired-lease index for
// SENDING jobs.
